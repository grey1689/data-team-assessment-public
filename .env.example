# Copy to `.env` and fill passwords. Never commit `.env`.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zbd_development
POSTGRES_SCHEMA=proxy

# Superuser used only by scripts/provision_app_role.py
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# Application role used by dbt and loaders after provisioning
POSTGRES_USER=zbd_app
POSTGRES_PASSWORD=
